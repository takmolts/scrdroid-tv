<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <!-- Fire TV 版: 暗い背景に合わせてダークテーマにする（ダイアログの文字が黒くならないように） -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/TvDialog</item>
        <item name="android:colorAccent" tools:ignore="NewApi">#3C93F0</item>
        <!-- Customize your theme here. -->
        <!--        <item name="android:textColor">@color/white</item>-->
        <item name="android:textColorHint">#A8AAB5</item>
        <item name="android:colorPrimaryDark" tools:ignore="NewApi">#3C93F0
        </item>  <!--这一句控制状态栏背景颜色-->

        <!--    spinner 下拉文本颜色    -->
        <!--        <item name="android:spinnerDropDownItemStyle">@style/mySpinnerItemStyle</item>-->
        <item name="android:spinnerItemStyle">@style/mySpinnerItemStyle</item>

        <!--给window窗口设置背景图-->
        <item name="android:windowBackground">@color/theme_color</item>
    </style>

    <style name="mySpinnerItemStyle" parent="@android:style/Widget.Holo.DropDownItem.Spinner">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ===== Fire TV 用の設定行スタイル ===== -->
    <style name="TvSettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TvSettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">2</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TvSettingSpinner">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">3</item>
        <item name="android:background">@drawable/tv_focus_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:spinnerMode">dialog</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TvSettingSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/tv_focus_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ダイアログ（接続先の編集・パスワード入力・設定の選択肢など）: 濃いグレー地に白文字 -->
    <style name="TvDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#2A2E36</item>
        <item name="android:colorAccent">#5AA8FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C8CAD5</item>
        <item name="android:textColorHint">#8A8C95</item>
        <item name="android:colorControlNormal">#C8CAD5</item>
        <item name="android:colorControlActivated">#5AA8FF</item>
    </style>
</resources>
